  m_Script: {fileID: 11500000, guid: a2e40976f4c49fc4bbc7e51347be4eb8, type: 3}
  m_Name: Honey 1 - Arrival
  m_EditorClassIdentifier: Assembly-CSharp::DessertFactory.Cutscene
  title: Honey 1 - Arrival
  background: {fileID: 0}
  lines:
  - speaker: {fileID: 0}
    portrait: {fileID: 0}
    text: A girl in a huge sun hat wanders in from the dunes, dragging a shovel behind
      her.
  - speaker: {fileID: 11400000, guid: 1185c07bf7da03042b0d7c3129ec5c8d, type: 2}
    portrait: {fileID: 0}
    text: Is this the dessert factory? The sign out there is half buried.
  - speaker: {fileID: 11400000, guid: 1185c07bf7da03042b0d7c3129ec5c8d, type: 2}
    portrait: {fileID: 0}
    text: I'm Honey. I've been digging around this desert my whole life, so if something
      sweet is under the sand I'll find it.
  - speaker: {fileID: 11400000, guid: 1185c07bf7da03042b0d7c3129ec5c8d, type: 2}
    portrait: {fileID: 0}
    text: Just point me at a deposit and keep the belts moving. Oh, and I get the
      first cookie.
